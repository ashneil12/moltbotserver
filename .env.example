# OpenClaw .env example
#
# Quick start:
# 1) Copy this file to `.env` (for local runs from this repo), OR to `~/.openclaw/.env` (for launchd/systemd daemons).
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.
#
# Env-source precedence for environment variables (highest -> lowest):
# process env, ./.env, ~/.openclaw/.env, then openclaw.json `env` block.
# Existing non-empty process env vars are not overridden by dotenv/config env loading.
# Note: direct config keys (for example `gateway.auth.token` or channel tokens in openclaw.json)
# are resolved separately from env loading and often take precedence over env fallbacks.

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
# Recommended if the gateway binds beyond loopback.
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Example generator: openssl rand -hex 32

# Optional alternative auth mode (use token OR password).
# OPENCLAW_GATEWAY_PASSWORD=change-me-to-a-strong-password

# Optional path overrides (defaults shown for reference).
# OPENCLAW_STATE_DIR=~/.openclaw
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
# OPENCLAW_HOME=~

# Optional: import missing keys from your login shell profile.
# OPENCLAW_LOAD_SHELL_ENV=1
# OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Model provider API keys (set at least one)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
#
# ⚠️  GEMINI_API_KEY is strongly recommended even if using a different primary
# provider. The memory stack defaults to Gemini models:
#   - Gemini Embed 2 for QMD memory embeddings
#   - Flash Lite for LCM conversation summarization
#   - Flash Lite for ByteRover knowledge curation
# Self-reflection uses your primary model, not Gemini.
# Without it, memory search and summarization fall back to your primary provider
# (if supported) or won't work. Get a free key at https://aistudio.google.com/apikey
# Alternative: swap to OpenAI (text-embedding-3-small + gpt-4o-mini) in openclaw.json.
# OPENROUTER_API_KEY=sk-or-...
# OPENCLAW_LIVE_OPENAI_KEY=sk-...
# OPENCLAW_LIVE_ANTHROPIC_KEY=sk-ant-...
# OPENCLAW_LIVE_GEMINI_KEY=...
# OPENAI_API_KEY_1=...
# ANTHROPIC_API_KEY_1=...
# GEMINI_API_KEY_1=...
# GOOGLE_API_KEY=...
# OPENAI_API_KEYS=sk-1,sk-2
# ANTHROPIC_API_KEYS=sk-ant-1,sk-ant-2
# GEMINI_API_KEYS=key-1,key-2

# Optional additional providers
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# MINIMAX_API_KEY=...
# SYNTHETIC_API_KEY=...

# Alibaba Cloud Bailian (Coding Plan) — 8 frontier models, one flat-rate key
# Get key at: Alibaba Cloud Model Studio (Singapore region)
# Presets: balanced (default) | coding | research | budget
# BAILIAN_API_KEY=sk-...
# BAILIAN_PRESET=balanced

# -----------------------------------------------------------------------------
# Channels (only set what you enable)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Optional channel env fallbacks
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=...
# OPENCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# -----------------------------------------------------------------------------
# Tools + voice/media (optional)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...

# ELEVENLABS_API_KEY=...
# XI_API_KEY=...  # alias for ElevenLabs
# DEEPGRAM_API_KEY=...

# -----------------------------------------------------------------------------
# Optimized Claw fork-specific settings
# These control features unique to this fork. See README.md for full details.
# -----------------------------------------------------------------------------

# --- Memory & Knowledge ---
# QMD local-first memory search sidecar (BM25 + vectors + reranking).
# Enabled by default. Set to false to disable.
# OPENCLAW_QMD_ENABLED=true

# ByteRover local knowledge curation powered by Gemini.
# Provide a Gemini API key to enable brv curate/query tools.
# Get a free key at: https://aistudio.google.com/apikey
# BYTEROVER_GEMINI_KEY=AIza...

# Lossless Claw (LCM) — DAG-based conversation memory.
# Pre-baked in Docker image. These tune summarization behavior.
# LCM_FRESH_TAIL_COUNT=20
# LCM_CONTEXT_THRESHOLD=
# LCM_SUMMARY_PROVIDER=
# LCM_SUMMARY_MODEL=

# --- Browser Containers ---
# Enable per-agent browser containers (each agent gets isolated browser).
# OPENCLAW_BROWSER_ENABLED=0

# --- Agent Behavior ---
# Human voice mode — more natural, conversational communication style.
# OPENCLAW_HUMAN_MODE_ENABLED=0

# Business Mode — transforms agent into a strategic business partner
# with a 22KB guide and 64 knowledge documents.
# OPENCLAW_BUSINESS_MODE_ENABLED=0

# Self-reflection frequency: 'normal' (default), 'high', or 'disabled'.
# OPENCLAW_SELF_REFLECTION=normal

# --- Search & Scraping Sidecars (Docker only) ---
# SearXNG metasearch — free, API-key-free, 70+ engines.
# Set automatically in docker-compose. Override if running separately.
# SEARXNG_BASE_URL=http://searxng:8080
# SEARXNG_ENGINES=google,bing,duckduckgo,wikipedia

# Scrapling stealth scraping — anti-bot-bypass via Playwright.
# Set automatically in docker-compose. Override if running separately.
# SCRAPLING_BASE_URL=http://scrapling:8765
# SCRAPLING_STEALTH_CONCURRENCY=5
# SCRAPLING_TIMEOUT=30

# --- Backups (managed hosting — optional for self-hosted) ---
# MOLTBOT_BACKUP_ENABLED=true
# MOLTBOT_LOCAL_BACKUP_DIR=~/.clawdbot/local-backups
# MOLTBOT_SUPABASE_URL=
# MOLTBOT_SUPABASE_SERVICE_ROLE_KEY=
# MOLTBOT_INSTANCE_ID=

# --- Docker image overrides (for docker-compose) ---
# OPENCLAW_IMAGE=openclaw:local
# OPENCLAW_TZ=UTC
